# PRO — non-secret defaults. SMTP credentials from SSM /ads/shared/contact/* at runtime.
APP_ENV=production

# OpenAPI / Swagger: always disabled when APP_ENV=production (ADR 0012 / AS-61).
# Leaving these blank also disables docs in non-production.
# APP_DOCS_URL=
# APP_REDOC_URL=
# APP_OPENAPI_URL=

EMAIL_PROVIDER=smtp
SMTP_HOST=email-smtp.eu-north-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
CONTACT_EMAIL_TO=ads.serviciosintegrales@gmail.com
CONTACT_EMAIL_FROM=contacto@ads-inversiones.es
CONTACT_PUBLIC_WEBSITE_URL=https://ads-inversiones.es
CONTACT_FOOTER_EMAIL=ads.serviciosintegrales@gmail.com
CONTACT_FOOTER_WEBSITE=https://ads-inversiones.es/
CONTACT_CONFIRMATION_SUBJECT=RE: confirmacion de solicitud

# Browser origins allowed to call the API (CORS). Not a network ACL — see ADR 0012.
CORS_ORIGINS=https://ads-inversiones.es,https://www.ads-inversiones.es,https://backoffice.ads-inversiones.es

# Auth (JWT) — set a strong secret in SSM / secrets manager; never use the dev placeholder
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Web vehicles media (S3). PRO bucket historically ads-pro-web-<account>.
WEB_VEHICLES_S3_BUCKET=
WEB_VEHICLES_S3_PREFIX=images/stock
# Optional public CDN/site origin for image keys (e.g. https://ads-inversiones.es).
WEB_VEHICLES_PUBLIC_MEDIA_BASE_URL=https://ads-inversiones.es
