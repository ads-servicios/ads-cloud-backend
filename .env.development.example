# Copy to .env for local development (never commit .env)
APP_ENV=development

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ads_cloud

# Email — Amazon SES SMTP (same as PRO; credentials from SSM after terraform apply)
EMAIL_PROVIDER=smtp
SMTP_HOST=email-smtp.eu-north-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
CONTACT_EMAIL_TO=ads.serviciosintegrales@gmail.com
CONTACT_EMAIL_FROM=contacto@ads-inversiones.es
CONTACT_PUBLIC_WEBSITE_URL=http://localhost:3000
CONTACT_FOOTER_EMAIL=ads.serviciosintegrales@gmail.com
CONTACT_FOOTER_WEBSITE=https://ads-inversiones.es/
CONTACT_CONFIRMATION_SUBJECT=RE: confirmacion de solicitud

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Auth (JWT) — change jwt_secret outside development
JWT_SECRET=dev-only-change-me-use-32b-min-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Optional: create first administrator when users table is empty
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Web vehicles → public web bucket (e.g. ads-pro-web-… / ads-dev-images-…)
WEB_VEHICLES_S3_BUCKET=
WEB_VEHICLES_S3_PREFIX=images/stock
# Optional public origin (CloudFront / site). Else API presigns private-bucket GETs.
WEB_VEHICLES_PUBLIC_MEDIA_BASE_URL=
WEB_VEHICLES_S3_PRESIGN_EXPIRES=3600
# Local Docker needs AWS creds with s3:PutObject on that bucket:
# - mount ~/.aws into the API container (docker-compose does this), OR
# - set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (never commit real values)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
