APP_NAME=ads-cloud-system
APP_VERSION=0.1.0
APP_DESCRIPTION=ADS Cloud System API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ads_cloud
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Email — see .env.development.example | .env.pre.example | .env.production.example
EMAIL_PROVIDER=smtp
AWS_REGION=eu-north-1
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
CONTACT_EMAIL_TO=ads.serviciosintegrales@gmail.com
CONTACT_EMAIL_FROM=ads.serviciosintegrales@gmail.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Auth (JWT)
JWT_SECRET=dev-only-change-me-use-32b-min-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Web vehicles media (S3). Required for POST/PUT/PATCH when uploading image binaries.
# Existing keys under images/stock/… are kept without re-upload.
WEB_VEHICLES_S3_BUCKET=
WEB_VEHICLES_S3_PREFIX=images/stock
# Optional public CDN/site origin for image reads (e.g. https://ads-inversiones.es).
# If empty, API returns S3 presigned GET URLs when the bucket is private.
WEB_VEHICLES_PUBLIC_MEDIA_BASE_URL=
WEB_VEHICLES_S3_PRESIGN_EXPIRES=3600
# Optional explicit keys (prefer IAM role / ~/.aws in local Docker)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
